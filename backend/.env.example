# ---------------------------------------------------------------------------
# RailFlow AI - backend configuration (development defaults)
# Copy to `.env` and adjust. No real secrets belong in this file.
# ---------------------------------------------------------------------------

# Authoritative database. Production: PostgreSQL. Local fallback: SQLite.
# DATABASE_URL=postgresql+psycopg://railflow:railflow@localhost:5432/railflow
DATABASE_URL=sqlite:///./railflow.db

# Optional Redis for queue / cache / rate limiting. Leave empty to use the
# in-process fallback (documented in the README).
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- virtual waiting queue -------------------------------------------------
QUEUE_CAPACITY=40
QUEUE_ADMISSION_RATE=12
QUEUE_ENTRY_TTL_SECONDS=900

# --- reservations ----------------------------------------------------------
HOLD_MINUTES=10
IDEMPOTENCY_TTL_MINUTES=1440

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_PER_MINUTE=600

# --- background workers ----------------------------------------------------
EXPIRY_INTERVAL_SECONDS=2
RECONCILIATION_INTERVAL_SECONDS=3
RECONCILIATION_STALE_SECONDS=12
RUN_WORKERS=true

# --- security --------------------------------------------------------------
ADMIN_API_KEY=railflow-demo-admin-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- simulation lab --------------------------------------------------------
RANDOM_SEED=20260214
SIM_MAX_CONCURRENT_REQUESTS=300
SIM_MAX_SEATS=300

# --- misc ------------------------------------------------------------------
DEMO_MODE=true
APP_NAME=RailFlow AI
APP_VERSION=1.0.0
